<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 基础权限页四项系统权限：存储 / 悬浮窗 / 电池优化豁免 / 位置 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 网络：服务商 API（模型列表 / 测试连接）与 pi 通道 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Shizuku 调试通道：向 Shizuku 服务申请 ADB 级授权 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <!-- 前台服务保活：pi 与终端会话都是应用子进程，退后台/熄屏被清即断；
         默认按需前台化（AI 回合 / 终端脚本 / 终端会话有活时才挂），行为设置「后台常驻通知」打开后
         转常驻档；见 runtime/PiKeepAlive.kt -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 常驻档的服务类型权限：specialUse 没有 dataSync 的「后台累计 6 小时 / 24 小时」
         时限，见 runtime/PiKeepAlive.kt 的 foregroundType() -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 通知权限（Android 13+）：没有它前台服务的通知不显示（服务本身仍可运行）；
         开启「后台常驻通知」时会当场申请一次（行为设置页），基础权限页不重复收口 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 震动（消息通知的「震动提醒」）：通知渠道的震动属性需要它，见 runtime/ReplyNotify.kt -->
    <uses-permission android:name="android.permission.VIBRATE" />


    <!-- 包可见性（Android 11+）：权限页要探测 Shizuku 与各 Root 管理器是否安装，
         未在 <queries> 声明的包 getPackageInfo 一律抛 NameNotFoundException（
         装了 Shizuku 也显示「未安装」）。
         这里按需声明具体包名，最小化可见范围。 -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="com.rifsxd.ksunext" />
        <package android:name="me.bmax.apatch" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pient"
        android:usesCleartextTraffic="true"><!-- AI 端点允许明文 HTTP：自建/本地端点（Ollama、内网网关、10.0.2.2 调试）常用 http:// -->

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- android-image-cropper 的裁剪页：库要求 AppCompat 主题 -->
        <activity
            android:name="com.canhub.cropper.CropImageActivity"
            android:exported="false"
            android:theme="@style/Theme.Pient.CropImage"
            tools:replace="android:exported" />

        <!-- 前台服务保活：按需档（AI 回合 / 终端脚本 / 终端会话）与
             「后台常驻通知」常驻档共用这一个服务；pi 子进程与 stdin/stdout 管道退后台不被系统清掉。
             两种前台服务类型都在这里声明，运行时由 PiKeepAlive 按档位二选一
             （常驻 = specialUse：dataSync 在 Android 15 起有「后台累计 6 小时 / 24 小时」上限） -->
        <service
            android:name=".runtime.PiKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <!-- Android 14+ 要求 specialUse 声明用途（也是 Play 审核的说明位） -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled resident notification: keeps the pi agent child process and terminal sessions alive while the app is in the background or the screen is off." />
        </service>

        <!-- Shizuku binder 接收 Provider（dev.rikka.shizuku:provider）：
             缺此声明时 Shizuku SDK 抛 "Please add dev.rikka.shizuku:provider"，运行/授权状态读不到 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- 拍照附件（\"+\" 菜单）：FileProvider 暂存相机输出 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
