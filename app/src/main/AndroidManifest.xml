<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 基础权限页四项系统权限（Operit 同款声明）：存储 / 悬浮窗 / 电池优化豁免 / 位置 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- AI 对话：直连服务商 API（2026-09-09） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Shizuku 调试通道（2026-09-12）：向 Shizuku 服务申请 ADB 级授权 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- 后台保活（2026-09-12，开发计划 §6.4）：宿主跑在前台服务里，常驻通知「Agent 运行中」。
         dataSync 类型是唯一不需要额外用户动作即可长期持有的类型（Google Play 政策口径）。
         Android 13+ 没给 POST_NOTIFICATIONS 时服务照常运行，只是通知不显示。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 包可见性（Android 11+）：权限页要探测 Shizuku 与各 Root 管理器是否安装，
         未在 <queries> 声明的包 getPackageInfo 一律抛 NameNotFoundException（实测踩过：
         装了 Shizuku 也显示「未安装」）。Operit 用 QUERY_ALL_PACKAGES 全量放开，
         这里按需声明具体包名，最小化可见范围。 -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="com.rifsxd.ksunext" />
        <package android:name="me.bmax.apatch" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pient"
        android:usesCleartextTraffic="true"><!-- AI 端点允许明文 HTTP：自建/本地端点（Ollama、内网网关、10.0.2.2 调试）常用 http:// -->

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- android-image-cropper 的裁剪页：库要求 AppCompat 主题 -->
        <activity
            android:name="com.canhub.cropper.CropImageActivity"
            android:exported="false"
            android:theme="@style/Theme.Pient.CropImage"
            tools:replace="android:exported" />

        <!-- Shizuku binder 接收 Provider（dev.rikka.shizuku:provider）：
             缺此声明时 Shizuku SDK 抛 "Please add dev.rikka.shizuku:provider"，运行/授权状态读不到 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- 拍照附件（\"+\" 菜单）：FileProvider 暂存相机输出（2026-09-09） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- pi 宿主的前台服务容器（工具层保活）：常驻通知 + START_STICKY；
             stopWithTask=false 让「划掉最近任务」不杀宿主（开发计划 §6.4） -->
        <service
            android:name=".runtime.PiHostService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />
    </application>

</manifest>
